    { "image": "screens/04-columns.png", "title": "Add the columns\n*you need*",
      "callout": { "crop": [53, 427, 974, 360], "y": 0.46, "width": 1.08 } },
    { "image": "screens/05-export.png", "title": "Save as *Excel*\nor CSV",
      "callout": { "crop": [53, 1176, 974, 401], "y": 0.70, "width": 1.04 } },
    { "image": "screens/dark-06-home.png", "title": "Works in\n*dark mode*", "icon": "moon" }
